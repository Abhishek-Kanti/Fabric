# Company Brain - Backend Environment Configuration

# Application
APP_NAME="Company Brain"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Logging
LOG_LEVEL="INFO"

# Database (PostgreSQL 16+)
POSTGRES_USER="company_brain"
POSTGRES_PASSWORD="company_brain_secret"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="company_brain"
DATABASE_URL="postgresql+asyncpg://company_brain:company_brain_secret@localhost:5432/company_brain"
TEST_DATABASE_URL="postgresql+asyncpg://company_brain:company_brain_secret@localhost:5432/company_brain_test"
